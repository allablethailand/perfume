echo vendor/ >> .gitignore
echo node_modules/ >> .gitignore
echo .env >> .gitignore
echo .DS_Store >> .gitignore
echo Thumbs.db >> .gitignore
echo *.log >> .gitignore
echo public/uploads/ >> .gitignore
echo public/img/uploads/ >> .gitignore
```

หรือสร้างไฟล์ `.gitignore` ด้วย text editor แล้วใส่:
```
# Dependencies
# vendor/
# node_modules/

# Environment variables
.env
.env.local

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log
error_log
access_log

# Uploads (ถ้าไม่ต้องการเก็บไฟล์ที่ user อัพโหลด)
public/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache
cache/
temp/
tmp/
# 2026-09-02 — กุญแจ service account เคยโหลดผ่านเว็บได้ (prod = trandar.com/perfume/)
# ย้ายไปเก็บนอกรากเว็บแล้ว: /home/cloudpanel/secrets/gcp_keys/
keydata*/
spatial-vision-*.json
test_api.php
